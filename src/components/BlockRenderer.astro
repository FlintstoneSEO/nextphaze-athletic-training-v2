---
import { componentMap } from "../cloudcannon/componentMap";

const { block } = Astro.props;
const { _type, ...props } = block;
const Component = componentMap[_type as keyof typeof componentMap];
---

{Component && (
  <div data-editable="array-item" data-component={_type}>
    <Component {...props} />
  </div>
)}
