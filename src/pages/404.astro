---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | NextPhaze Athletic Training"
  description="The requested NextPhaze Athletic Training page could not be found."
  canonicalPath="/"
  noindex
>
  <section class="page-hero" aria-labelledby="not-found-title">
    <div class="container">
      <p class="eyebrow">404 / Route missed</p>
      <h1 id="not-found-title">That page is out of bounds.</h1>
      <p class="lead">Return to NextPhaze or go straight to the training options.</p>
      <div class="button-row"><a class="button button-gold" href="/">Back home</a><a class="button button-ghost" href="/training/">View training</a></div>
    </div>
  </section>
</BaseLayout>
